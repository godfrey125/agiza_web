# Restaurant API environment
#
# Server-side only. Never expose these values to the browser bundle.

# Supabase Postgres connection string. Use the session pooler (port 5432) for
# this service: the restaurant schema relies on search_path, which transaction
# pooling does not preserve reliably.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional service-specific override. When the Django service uses the
# transaction pooler (6543), set this to the session pooler URL for the
# restaurant service instead of sharing DATABASE_URL.
# RESTAURANT_DATABASE_URL=

# Keep the restaurant pool small. Supabase's session pooler is capped at 15
# clients for the whole project, and Django uses some of that budget.
PG_POOL_MAX=2

# The Django SECRET_KEY used to sign SimpleJWT access tokens. The restaurant
# API verifies the same token, so this must match the Django service exactly.
DJANGO_JWT_SECRET=

# The single platform administrator allowed into the restaurant workspace.
PLATFORM_ADMIN_EMAIL=shorahgodfrey12@gmail.com

# Only used by the legacy restaurant password sessions. Set a long random value.
AUTH_SECRET=

# The path prefix the Express app mounts its routes on. The Vercel service
# transform rewrites /api/restaurant/* to /api/*, so keep the default.
AGIZA_API_PREFIX=/api
