# Django marketplace API environment
#
# Copy to .env for local development, or set these in the Vercel project
# environment variables for the `django` service.

# Use a long random value. This signs SimpleJWT access tokens; the restaurant
# service must receive the same value as DJANGO_JWT_SECRET.
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=.vercel.app,your-domain.com,localhost,127.0.0.1

# Supabase Postgres connection string (pooler host on Vercel).
# For the `django` service prefer the transaction pooler (port 6543) so many
# serverless instances can share the project connection budget:
#   ...pooler.supabase.com:6543/postgres?sslmode=require
# The session pooler (5432) also works for local development.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Close Django's database connections after each request. Supabase's session
# pooler is capped at 15 clients; persistent per-thread connections exhaust it.
DATABASE_CONN_MAX_AGE=0

# Supabase identity. The Django API verifies Google/Supabase access tokens and
# issues its own JWT pair.
SUPABASE_URL=https://prhnakmkhbxxobzidijj.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Optional. Only needed for Supabase Storage/admin operations, not for sign-in.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Only needed for legacy Supabase projects that still sign JWTs with HS256.
# New projects use the public JWKS endpoint and can leave this blank.
SUPABASE_JWT_SECRET=
SUPABASE_AUTO_PROVISION=true

# The only account allowed to open the marketplace admin console.
PLATFORM_ADMIN_EMAIL=shorahgodfrey12@gmail.com

# Browser origins allowed to call the API. On the single Vercel deployment the
# site and admin are same-origin, so this is mainly for local development.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com

# Firebase (push notifications, chat, account creation). Leave blank to disable.
FIREBASE_PROJECT_ID=agiza-3884d
FIREBASE_CREDENTIALS=
PHONE_LOGIN_EMAIL_DOMAIN=phone.agiza.app

# Background worker. Not required for request handling.
REDIS_URL=
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=

AGIZA_VENDOR_RESPONSE_SECONDS=60
AGIZA_CUSTOM_OFFER_WINDOW_SECONDS=300
