# Admin SPA environment (Vite)
#
# These values are compiled into the browser bundle. Only public values belong
# here. The Django and restaurant API secrets live in their own service envs.
#
# Same-origin APIs on the single Vercel deployment.
VITE_AGIZA_API_URL=/api
VITE_ADMIN_API_URL=/api/restaurant

# The one Google account allowed to open /admin.
VITE_AGIZA_ADMIN_EMAIL=shorahgodfrey12@gmail.com

# Supabase identity (Google sign-in). Only the project URL and anon/publishable
# key belong in the browser.
VITE_SUPABASE_URL=https://prhnakmkhbxxobzidijj.supabase.co
VITE_SUPABASE_ANON_KEY=

# Public links shown in the admin shell.
VITE_AGIZA_WEBSITE_URL=/
VITE_AGIZA_APK_URL=/downloads/agiza.apk
